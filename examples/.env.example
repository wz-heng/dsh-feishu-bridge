# Copy to .env and fill in real values, or export these directly in your
# shell/systemd unit/Docker env file. Never commit a filled-in copy of this
# file — .gitignore already excludes .env at the repo root.

DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=http://127.0.0.1:8000/v1

FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
FEISHU_TRANSPORT=ws
# FEISHU_VERIFICATION_TOKEN=xxxx
# FEISHU_ENCRYPT_KEY=xxxx

# Required — empty means the bridge answers no one (fail-closed). Onboard
# yourself via the /pair <code> printed to console at startup instead of
# filling this in by hand (see README "Getting your open_id") — or leave it
# empty and pair on first run.
FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx
# FEISHU_ALLOWED_CHAT_IDS=oc_xxxxxxxxxxxxxxxx

# One-time pairing-code onboarding — on by default, see README "Getting your
# open_id". Uncomment to change the defaults or disable it entirely.
# FEISHU_PAIRING=1
# FEISHU_PAIRING_TTL_SECONDS=900
# FEISHU_PAIRING_MAX_ATTEMPTS=5
# FEISHU_PAIRING_CODE_LENGTH=8
# FEISHU_PAIRING_STATE_PATH=data/feishu_paired_open_ids.json
