# Copy to .env and fill in real values, or export these directly in your
# shell/systemd unit/Docker env file. Never commit a filled-in copy of this
# file — .gitignore already excludes .env at the repo root.

DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=http://127.0.0.1:8000/v1

FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
FEISHU_TRANSPORT=ws
# FEISHU_VERIFICATION_TOKEN=xxxx
# FEISHU_ENCRYPT_KEY=xxxx

# Required — empty means the bridge answers no one (fail-closed).
FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx
# FEISHU_ALLOWED_CHAT_IDS=oc_xxxxxxxxxxxxxxxx
